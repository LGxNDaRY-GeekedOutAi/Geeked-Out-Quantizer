{
  "name": "geeked-out-quantizer",
  "version": "1.0.0",
  "description": "Open-source GGUF Large Language Model Quantizer — intelligent quantization pipeline with importance-aware IQ2_M support, memory management, and a Windows-native Electron desktop app",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LGxNDaRY-GeekedOutAi/geeked-out-quantizer.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "electron": "wait-on http://localhost:3000 && electron .",
    "start": "concurrently \"npm run build:main\" \"npm run dev:renderer\"",
    "dev:renderer": "vite dev",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "electron": "^30.0.0",
    "ggml": "^0.1.0"
  },
  "devDependencies": {
    "@types/electron": "^28.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0"
  }
}